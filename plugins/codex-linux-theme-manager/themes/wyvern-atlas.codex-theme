{
  "format": "codex-theme",
  "schemaVersion": 1,
  "exportedAt": "2026-10-31T03:58:11.920Z",
  "manifest": {
    "schemaVersion": 1,
    "id": "wyvern-atlas",
    "displayName": "Wyvern Atlas",
    "description": "A moonlit wyvern gliding over storm-carved mountain peaks.",
    "version": "1.0.0",
    "mode": "dark",
    "css": "theme.css",
    "art": "assets/artwork.webp",
    "design": {
      "layoutMode": "native-immersive",
      "backgroundScope": "workspace",
      "decorDensity": "balanced",
      "modeReason": "A moonlit wyvern gliding over storm-carved mountain peaks. The dark canvas preserves the scene's intended luminance and foreground contrast.",
      "artFocalPoint": "73% 43%",
      "textSafeRegion": "left 52%",
      "contrastStrategy": "Left-to-right theme-color veil; stronger conversation veil; raised native message, card and composer materials.",
      "allowedChanges": [
        "semantic palette",
        "native materials",
        "scoped home and conversation artwork",
        "non-interactive decorative surfaces"
      ],
      "preserve": [
        "native geometry",
        "native controls",
        "native interaction states",
        "settings and system-page artwork boundaries"
      ],
      "verificationViewports": [
        "1440x900",
        "980x760"
      ]
    },
    "palette": {
      "canvas": "#182431",
      "surface": "#202F3D",
      "raised": "#2A3B48",
      "text": "#E2E9E9",
      "muted": "#ABB9BC",
      "accent": "#B78A50",
      "border": "#465963",
      "focus": "#D4DCE1",
      "success": "#83B393",
      "warning": "#B88A49",
      "danger": "#C96D62",
      "terminalBackground": "#121D27",
      "terminalForeground": "#E2E9E9"
    },
    "typography": {
      "display": "IBM Plex Serif",
      "body": "DejaVu Sans Condensed"
    },
    "platforms": [
      "linux"
    ],
    "author": {
      "name": "Codex Linux Theme Manager"
    },
    "homepage": "https://github.com/outlawexotix/codex-linux-theme-manager",
    "skillUrl": "https://github.com/outlawexotix/codex-linux-theme-manager",
    "preview": "previews/design-preview-1440x900.webp"
  },
  "css": "/* Wyvern Atlas: native layout preserved; artwork is scoped to verified workspace pages. */\n:root[data-codexthemes-theme=\"wyvern-atlas\"] {\n  --ct-canvas: #182431;\n  --ct-surface: #202F3D;\n  --ct-raised: #2A3B48;\n  --ct-text: #E2E9E9;\n  --ct-muted: #ABB9BC;\n  --ct-accent: #B78A50;\n  --ct-accent-soft: color-mix(in srgb, var(--ct-accent) 18%, transparent);\n  --ct-border: #465963;\n  --ct-focus: #D4DCE1;\n  --ct-on-accent: #182431;\n  --ct-shadow: color-mix(in srgb, var(--ct-text) 18%, transparent);\n  --ct-art: url(\"./assets/artwork.webp\");\n  --ct-font-display: \"IBM Plex Serif\", serif;\n  --ct-font-body: \"DejaVu Sans Condensed\", sans-serif;\n  color-scheme: dark;\n  --color-background-surface: var(--ct-canvas) !important;\n  --color-background-surface-under: var(--ct-surface) !important;\n  --color-background-panel: var(--ct-surface) !important;\n  --color-background-control: var(--ct-raised) !important;\n  --color-background-control-opaque: var(--ct-raised) !important;\n  --color-background-editor-opaque: var(--ct-canvas) !important;\n  --color-background-elevated-primary: var(--ct-raised) !important;\n  --color-background-elevated-primary-opaque: var(--ct-raised) !important;\n  --color-background-elevated-secondary: var(--ct-surface) !important;\n  --color-background-elevated-secondary-opaque: var(--ct-surface) !important;\n  --color-text-foreground: var(--ct-text) !important;\n  --color-text-foreground-secondary: var(--ct-muted) !important;\n  --color-text-foreground-tertiary: var(--ct-muted) !important;\n  --color-icon-primary: var(--ct-text) !important;\n  --color-icon-secondary: var(--ct-muted) !important;\n  --color-icon-tertiary: var(--ct-muted) !important;\n  --color-border: var(--ct-border) !important;\n  --color-border-light: var(--ct-border) !important;\n  --color-border-heavy: var(--ct-border) !important;\n  --color-border-focus: var(--ct-focus) !important;\n  --color-token-bg-primary: var(--ct-canvas) !important;\n  --color-token-bg-secondary: var(--ct-surface) !important;\n  --color-token-bg-tertiary: var(--ct-raised) !important;\n  --color-token-main-surface-primary: var(--ct-canvas) !important;\n  --color-token-side-bar-background: var(--ct-surface) !important;\n  --color-token-foreground: var(--ct-text) !important;\n  --color-token-text-primary: var(--ct-text) !important;\n  --color-token-text-secondary: var(--ct-muted) !important;\n  --color-token-text-tertiary: var(--ct-muted) !important;\n  --color-token-description-foreground: var(--ct-muted) !important;\n  --color-token-icon-foreground: var(--ct-text) !important;\n  --color-token-input-background: var(--ct-raised) !important;\n  --color-token-input-foreground: var(--ct-text) !important;\n  --color-token-input-placeholder-foreground: var(--ct-muted) !important;\n  --color-token-input-border: var(--ct-border) !important;\n  --color-token-border: var(--ct-border) !important;\n  --color-token-border-default: var(--ct-border) !important;\n  --color-token-border-heavy: var(--ct-border) !important;\n  --color-token-border-light: var(--ct-border) !important;\n  --color-token-list-hover-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-list-active-selection-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-list-active-selection-foreground: var(--ct-text) !important;\n  --color-token-toolbar-hover-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-button-background: var(--ct-accent) !important;\n  --color-token-button-foreground: var(--ct-on-accent) !important;\n  --color-token-button-border: var(--ct-border) !important;\n  --color-token-link: var(--ct-accent) !important;\n  --color-token-text-link-foreground: var(--ct-accent) !important;\n  --color-token-text-link-active-foreground: var(--ct-accent) !important;\n  --color-token-primary: var(--ct-accent) !important;\n  --color-token-focus-border: var(--ct-focus) !important;\n  --color-token-dropdown-background: var(--ct-raised) !important;\n  --color-token-dropdown-foreground: var(--ct-text) !important;\n  --color-token-menu-background: var(--ct-raised) !important;\n  --color-token-menu-border: var(--ct-border) !important;\n  --color-token-checkbox-background: var(--ct-raised) !important;\n  --color-token-checkbox-border: var(--ct-border) !important;\n  --color-token-checkbox-foreground: var(--ct-accent) !important;\n  --color-token-badge-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-badge-foreground: var(--ct-text) !important;\n  --color-token-scrollbar-slider-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-scrollbar-slider-hover-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-scrollbar-slider-active-background: color-mix(in srgb, var(--ct-accent) 18%, transparent) !important;\n  --color-token-conversation-header: var(--ct-muted) !important;\n  --color-token-conversation-body: var(--ct-text) !important;\n  --color-token-conversation-summary-leading: var(--ct-muted) !important;\n  --color-token-conversation-summary-trailing: var(--ct-muted) !important;\n  --color-token-non-assistant-body-descendant: var(--ct-text) !important;\n  --color-token-text-preformat-foreground: var(--ct-text) !important;\n  --color-token-text-preformat-background: var(--ct-surface) !important;\n  --color-token-text-code-block-background: var(--ct-surface) !important;\n}\n\n/* Workspace artwork: a strong text-safe veil on the left, focal artwork on the right. */\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] {\n  color: var(--ct-text);\n  background-color: var(--ct-canvas);\n  background-image:\n    radial-gradient(circle at 94% 12%, var(--ct-accent-soft) 0 2px, transparent 3px),\n    linear-gradient(90deg, color-mix(in srgb, var(--ct-canvas) 97%, transparent) 0%, color-mix(in srgb, var(--ct-canvas) 84%, transparent) 44%, color-mix(in srgb, var(--ct-canvas) 34%, transparent) 100%),\n    var(--ct-art);\n  background-position: right top, center, 73% 43%;\n  background-size: 83px 83px, auto, cover;\n  background-repeat: repeat, no-repeat, no-repeat;\n  font-family: var(--ct-font-body);\n}\nmain[data-app-shell-main-surface][data-codexthemes-page=\"conversation\"] {\n  color: var(--ct-text);\n  background-color: var(--ct-canvas);\n  background-image:\n    linear-gradient(90deg, var(--ct-canvas) 0%, color-mix(in srgb, var(--ct-canvas) 94%, transparent) 53%, color-mix(in srgb, var(--ct-canvas) 62%, transparent) 100%),\n    var(--ct-art);\n  background-position: center, right center;\n  background-size: auto, cover;\n  background-repeat: no-repeat;\n  font-family: var(--ct-font-body);\n}\n\n/* Scoped home staging and native suggestion cards. */\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] .home-composer-anchor {\n  border: 1px solid var(--ct-border);\n  border-radius: 20px;\n  background: linear-gradient(105deg, color-mix(in srgb, var(--ct-surface) 94%, transparent), color-mix(in srgb, var(--ct-surface) 72%, transparent));\n  box-shadow: 0 12px 28px var(--ct-shadow);\n}\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [data-feature=\"game-source\"] {\n  color: var(--ct-text);\n  font-family: var(--ct-font-display);\n  text-shadow: 0 1px 12px var(--ct-shadow);\n}\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [class~=\"group/home-suggestion-list-item\"] {\n  color: var(--ct-text);\n  background: linear-gradient(145deg, var(--ct-raised), var(--ct-surface));\n  border: 1px solid var(--ct-border);\n  box-shadow: 0 5px 16px var(--ct-shadow);\n  transition: border-color .18s ease, box-shadow .18s ease;\n}\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [class~=\"group/home-suggestion-list-item\"]:hover {\n  border-color: var(--ct-accent);\n  box-shadow: 0 8px 22px var(--ct-shadow);\n}\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [data-composer-layout=\"multiline\"][data-composer-surface-variant] {\n  color: var(--ct-text);\n  background: linear-gradient(160deg, var(--ct-raised), var(--ct-surface));\n  border: 1px solid var(--ct-border);\n  box-shadow: 0 9px 24px var(--ct-shadow), inset 0 1px 0 color-mix(in srgb, var(--ct-accent) 22%, transparent);\n}\n[data-codex-composer=\"true\"] { color: var(--ct-text); caret-color: var(--ct-accent); }\n\n/* Native shell materials and states. */\naside.app-shell-left-panel {\n  color: var(--ct-text);\n  background: var(--ct-surface);\n  border-color: var(--ct-border);\n  font-family: var(--ct-font-body);\n}\naside.app-shell-left-panel [class~=\"sidebar-item\"]:hover { background-color: var(--ct-accent-soft); }\n[data-app-shell-titlebar=\"true\"] { color: var(--ct-text); background: var(--ct-surface); border-color: var(--ct-border); }\n[role=\"menu\"], [role=\"dialog\"] { color: var(--ct-text); background: var(--ct-raised); border-color: var(--ct-border); box-shadow: 0 12px 32px var(--ct-shadow); }\n\n/* Mounted terminal islands may own inline light-mode tokens. */\n[data-codex-terminal=\"true\"] {\n  --vscode-terminal-background: #121D27 !important;\n  --vscode-terminal-foreground: #E2E9E9 !important;\n  --color-background-panel: var(--ct-surface) !important;\n  --color-background-editor-opaque: #121D27 !important;\n  color: var(--ct-text) !important;\n  background: #121D27 !important;\n}\n.xterm, .xterm-screen { color: var(--ct-text) !important; background: #121D27 !important; }\n.xterm-viewport { background-color: #121D27 !important; }\n:focus-visible { outline-color: var(--ct-focus); }\n::selection { color: var(--ct-text); background: var(--ct-accent-soft); }\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"], main[data-app-shell-main-surface][data-codexthemes-page=\"conversation\"], aside.app-shell-left-panel { scrollbar-color: var(--ct-accent) transparent; }\n@media (max-width: 980px) {\n  main[data-app-shell-main-surface][data-codexthemes-page=\"home\"] { background-position: right top, center, 68% center; }\n  main[data-app-shell-main-surface][data-codexthemes-page=\"conversation\"] { background-position: center, 72% center; }\n}\n@media (prefers-reduced-motion: reduce) {\n  main[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [class~=\"group/home-suggestion-list-item\"] { transition-duration: .01ms !important; }\n}\n\n/* Signature line: non-interactive and attached to the inspected home heading. */\nmain[data-app-shell-main-surface][data-codexthemes-page=\"home\"] [data-feature=\"game-source\"]::after { content: \"  ✦ Above the weather.\"; color: var(--ct-accent); font-family: var(--ct-font-body); font-size: .34em; letter-spacing: .04em; pointer-events: none; }\n",
  "readme": "# Wyvern Atlas\n\nA moonlit wyvern gliding over storm-carved mountain peaks.\n\n- Mode: dark; home and conversation artwork, with Codex geometry preserved.\n- Display type: IBM Plex Serif\n- Body type: DejaVu Sans Condensed\n- Art focal point: 73% 43%; text-safe region: left 52%.\n- Status: designed package; live-app visual QA has not been run.\n",
  "art": {
    "filename": "artwork.webp",
    "mimeType": "image/webp",
    "base64": ""
  },
  "preview": {
    "filename": "design-preview-1440x900.webp",
    "mimeType": "image/webp",
    "base64": ""
  },
  "verification": {
    "status": "not-verified",
    "designPreview": true,
    "staticValidator": "passed",
    "liveAppVisualQA": "not-run"
  }
}
